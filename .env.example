# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. See docs/09-security-design.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3001
TZ=Asia/Kolkata

# ── Operating mode ───────────────────────────────────────────────────────────
# off | review | easy_apply   (see README → Operating modes)
AUTO_APPLY_MODE=off
# auto-apply (easy_apply mode) only fires above this match score
AUTO_APPLY_MIN_SCORE=80
# master kill-switch for any outbound action (apply/connect/message)
OUTBOUND_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jsa:jsa_password@localhost:5432/job_search_agent?schema=public

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PRIMARY=claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001   # cheap pass for JD extraction/scoring
OPENAI_API_KEY=sk-xxxxxxxx                        # fallback only
OPENAI_MODEL=gpt-4o

# ── Browser automation (Playwright) ──────────────────────────────────────────
HEADLESS=false
STORAGE_STATE_DIR=./storage-state
SCRAPER_MAX_CONCURRENCY=1
HUMAN_DELAY_MIN_MS=1500
HUMAN_DELAY_MAX_MS=6000

# ── Google Sheets ────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
GSHEET_TRACKER_ID=your_google_sheet_id

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_xxxxxxxx
NOTION_JOBS_DB_ID=xxxxxxxx

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# ── Gmail (report email) ─────────────────────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx        # Google App Password, NOT your real password
REPORT_TO_EMAIL=you@gmail.com

# ── Slack (optional) ─────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=change_me_long_random
API_INTERNAL_TOKEN=change_me_long_random       # n8n ⇄ api shared bearer
